# Optional override for a local Hugging Face cache or model configuration.
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Original resume files remain in SQLite unless S3 is explicitly selected.
RESUME_STORAGE_BACKEND=sqlite
# On EC2, use an instance role instead of storing AWS access keys here.
S3_BUCKET=
S3_RESUME_PREFIX=resumes
AWS_REGION=
